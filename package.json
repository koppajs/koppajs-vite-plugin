{
  "name": "@koppajs/koppajs-vite-plugin",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koppajs/koppajs-vite-plugin.git"
  },
  "description": "KoppaJS Vite Plugin - Seamless Integration for KoppaJS Framework with Vite",
  "keywords": [
    "koppa",
    "koppajs",
    "koppa.js",
    "frontend",
    "framework",
    "ui-framework",
    "typescript",
    "vite",
    "reactivity",
    "single-file-components",
    "modular",
    "lightweight",
    "high-performance",
    "web-development",
    "javascript"
  ],
  "author": "Bastian Bensch",
  "license": "Apache-2.0",
  "homepage": "https://koppajs.org",
  "scripts": {
    "prepare": "husky",
    "generate:types": "tsc --project tsconfig.types.json",
    "clean": "rimraf coverage dist",
    "typecheck": "tsc --project tsconfig.json",
    "build": "pnpm run typecheck && vite build --config vite.config.ts && pnpm run generate:types",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "vitest --run",
    "test:run": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:ci": "pnpm run test:coverage",
    "test:package": "node scripts/check-package-output.mjs",
    "lint": "eslint . --max-warnings=0 && oxlint --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0 && oxlint --fix --max-warnings=0",
    "format": "prettier --config prettier.config.mjs --write .",
    "format:check": "prettier --config prettier.config.mjs --check .",
    "check": "pnpm run check:docs && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:run",
    "validate": "pnpm run check:docs && pnpm run format:check && pnpm run lint && pnpm run test:ci && pnpm run build && pnpm run test:package",
    "check:docs": "node scripts/check-doc-contract.mjs"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.24.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "commitlint": "^21.2.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "1.90.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "terser": "^5.51.2",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "get-tsconfig": "^4.14.3",
    "oxc-parser": "0.156.0",
    "postcss": "^8.5.32",
    "sass": "^1.107.1"
  },
  "overrides": {
    "glob": "^11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  },
  "private": false
}
