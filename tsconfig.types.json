{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Emit declarations only
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,

    // Declaration output location
    "rootDir": "src",
    "outDir": "dist"
  },
  // Only the public entrypoint:
  // Everything exported from src/index.ts
  // belongs to the public API.
  "include": ["src/index.ts"]
}
